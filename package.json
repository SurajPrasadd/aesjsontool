{
  "name": "aesjsonxml",
  "displayName": "AES JSON XML Tool",
  "description": "AES-128/192/256 encrypt & decrypt (ECB/CBC/CTR/CFB/OFB/GCM) plus a JSON & XML validator, beautifier, tree viewer, and side-by-side diff — all inside a VS Code webview panel.",
  "version": "1.0.3",
  "publisher": "SurajPrasad1993",
  "engines": {
    "vscode": "^1.136.0"
  },
  "repository":{
    "type": "git",
    "url": "https://github.com/SurajPrasadd/aesjsontool.git"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "icon":"icon.ico",
  "keywords": [
    "aes",
    "encrypt",
    "decrypt",
    "cryptography",
    "json",
    "xml",
    "formatter",
    "beautify",
    "jwt",
    "base64",
    "epoch",
    "timestamp",
    "converter",
    "html",
    "css",
    "playground"
  ],
  "activationEvents": [
    "onCommand:aesjsontool.open",
    "onCommand:aesjsontool.beautifyJsonXml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aesjsontool.open",
        "title": "AES JSON",
        "category": "Workbench"
      },
      {
        "command": "aesjsontool.beautifyJsonXml",
        "title": "Beautify JSON/XML (Current Document)",
        "category": "Workbench"
      }
    ],
    "keybindings": [
      {
        "command": "aesjsontool.beautifyJsonXml",
        "key": "ctrl+alt+;",
        "mac": "cmd+alt+;",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aesjsontool.open"
        },
        {
          "command": "aesjsontool.beautifyJsonXml"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
